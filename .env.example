# Every variable your app needs, one per line: NAME=   # what it is for
# Copy this file to .env (never committed) and fill it in. On Render, add them in your service's Environment page.
# check.py fails if a variable listed here is not set, unless its line says (optional).

GEMINI_API_KEY=       # Reads public tender notices

# Logs database: not needed to run the app. Render sets DATABASE_URL for the online app;
# leave it empty here, so your tests are logged to logs/ and not to the online database.
DATABASE_URL=          # (optional) set by Render, leave empty
LOGS_DATABASE_URL=     # (optional) External Database URL, only for `main.py export-logs`
