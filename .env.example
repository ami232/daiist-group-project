# Every variable your app needs, one per line: NAME=   # what it is for
# Copy this file to .env (never committed) and fill it in. On the Space, add them as secrets.
# check.py fails if a variable listed here is not set, unless its line says (optional).

# Uncomment the ones your app uses, and say what for:
# GEMINI_API_KEY=      # e.g. the agent that drafts the reply
# ROBOFLOW_API_KEY=    # e.g. the hosted damage detector

# Hugging Face: not needed to run the app, only to deploy it and keep its logs
HF_TOKEN=              # (optional) token with write permission
HF_SPACE=              # (optional) <user>/<space-name>
HF_LOG_REPO=           # (optional) <user>/<space-name>-logs, a private dataset
