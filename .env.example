# Every variable your app needs, one per line: NAME=   # what it is for
# Copy this file to .env (never committed) and fill it in. On Render, add them in your service's Environment page.
# check.py fails if a variable listed here is not set, unless its line says (optional).

GEMINI_API_KEY=        # Gemini API key (https://aistudio.google.com/apikey): the work-order agent (component B) and the LLM judge

# Optional settings. The defaults in maintai/config.py are used when they are empty.
GEMINI_MODEL=          # (optional) agent model, default gemini-3.5-flash-lite
GEMINI_JUDGE_MODEL=    # (optional) LLM judge model, default gemini-3.8-flash
DAILY_LLM_BUDGET=      # (optional) max Gemini calls per day before the app switches to degraded mode, default 400
LLM_CACHE=             # (optional) readwrite | readonly | off. Default readonly locally; Render sets off (always live)

# Optional app settings (app.py). Leave empty to use the defaults; none of them is needed by check.py.
MAINTAI_RUN_CONCURRENCY=  # (optional) /run requests processed at the same time, default 2 (Render free: 0.15 CPU, 512 MB)
MAINTAI_QUEUE_MAX_SIZE=   # (optional) requests that may wait in the queue before new ones are refused, default 16
MAINTAI_SOURCE=           # (optional) label logged with each request, default real. Only "real" traffic can train the bandit

# Logs database: not needed to run the app. Render sets DATABASE_URL for the online app;
# leave it empty here, so your tests are logged to logs/ and not to the online database.
DATABASE_URL=          # (optional) set by Render, leave empty
LOGS_DATABASE_URL=     # (optional) External Database URL, only for `main.py export-logs`
